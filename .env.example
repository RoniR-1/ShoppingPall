# Local PostgreSQL credentials match compose.yaml.
DATABASE_URL=postgresql://aimo:aimo@127.0.0.1:5432/aimo
HOST=127.0.0.1
PORT=3000
# Explicit mock mode for repeatable offline demos; set false for Valio.
VALIO_MOCK=true
VALIO_BASE_URL=
VALIO_API_KEY=
BACKEND_URL=
OLLAMA_URL=
OLLAMA_MODEL=
OLLAMA_TIMEOUT_MS=

# Three-tier web portal (npm run web)
BACKEND_PORT=
MIDDLE_LAYER_PORT=
FRONTEND_PORT=
CORE_API_KEY=
SUSPICION_THRESHOLD=
LUNA_API_KEY=
LUNA_BASE_URL=
LUNA_MODEL=
# Demo requires no database URL. Real mode uses PostgreSQL.
REAL_DATABASE_URL=
