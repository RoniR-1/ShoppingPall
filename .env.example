# For a new setup, copy to .env and replace placeholders. For an existing .env, merge settings and preserve credentials.
DATABASE_URL=postgresql://aimo:aimo@127.0.0.1:5432/aimo
# Enables simulated local checkout; prices and availability still come from the database.
VALIO_MOCK=true
# Used by npm run export:valio and legacy catalog downloads, never runtime price/availability requests.
VALIO_BASE_URL=https://junction26.valioaimo.fi
VALIO_API_KEY=
# Optional snapshot customer and delivery date (defaults: 123 and today in Helsinki).
# VALIO_CATALOG_CUSTOMER=123
# VALIO_CATALOG_DATE=2026-11-16
# Gemini OpenAI-compatible endpoint. Use https://generativelanguage.googleapis.com/v1beta
# for the native Gemini API instead.
LUNA_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LUNA_API_KEY=your_api_key_here
# Highest priority first. This overrides the older single-model LUNA_MODEL setting.
LUNA_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Timeout per model attempt, and wait before retrying an unavailable model (milliseconds).
LUNA_TIMEOUT_MS=10000
LUNA_COOLDOWN_MS=60000
# Maximum generated tokens, including reasoning tokens.
LUNA_MAX_TOKENS=8192
